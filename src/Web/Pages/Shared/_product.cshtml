@model CatalogItemViewModel

<article class="ui-product">
    <form class="ui-product__form" asp-page="/Basket/Index" method="post">
        <div class="ui-product__media">
            <img class="ui-product__image" src="@Model.PictureUri" alt="@Model.Name" />
        </div>
        <h3 class="ui-product__name">@Model.Name</h3>
        <div class="ui-product__price">
            <span class="ui-product__currency">$</span>@Model.Price.ToString("N2")
        </div>
        <div class="ui-product__actions">
            <input class="ui-product__button" type="submit" value="[ ADD TO BASKET ]" />
        </div>
        <input type="hidden" asp-for="@Model.Id" name="id" />
        <input type="hidden" asp-for="@Model.Name" name="name" />
        <input type="hidden" asp-for="@Model.PictureUri" name="pictureUri" />
        <input type="hidden" asp-for="@Model.Price" name="price" />
    </form>
</article>
