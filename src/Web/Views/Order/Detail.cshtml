@model OrderDetailViewModel
@{
    ViewData["Title"] = "Order Detail";
}

<div class="ui-page-head">
    <div class="ui-container">
        <h1 class="ui-page-head__title">Order @Model.OrderNumber</h1>
        <p class="ui-page-head__subtitle">Placed on @Model.OrderDate</p>
    </div>
</div>

<div class="ui-container ui-section">
    <div class="ui-stack">
        <div class="ui-card">
            <div class="ui-card__body">
                <div class="ui-order-meta">
                    <div>
                        <span class="ui-order-meta__label">Order number</span>
                        <span class="ui-order-meta__value">@Model.OrderNumber</span>
                    </div>
                    <div>
                        <span class="ui-order-meta__label">Date</span>
                        <span class="ui-order-meta__value">@Model.OrderDate</span>
                    </div>
                    <div>
                        <span class="ui-order-meta__label">Status</span>
                        <span class="ui-order-meta__value"><span class="ui-badge">@Model.Status</span></span>
                    </div>
                    <div>
                        <span class="ui-order-meta__label">Shipping address</span>
                        <span class="ui-order-meta__value">
                            @Model.ShippingAddress?.Street, @Model.ShippingAddress?.City, @Model.ShippingAddress?.Country
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="ui-card">
            <div class="ui-card__body">
                <h2 class="ui-card__title">Items</h2>
            </div>
            <div class="ui-lines">
                <div class="ui-line ui-line--head">
                    <span class="ui-line__col-title"></span>
                    <span class="ui-line__col-title">Product</span>
                    <span class="ui-line__col-title">Unit price</span>
                    <span class="ui-line__col-title">Quantity</span>
                    <span class="ui-line__col-title">Total</span>
                </div>
                @foreach (var item in Model.OrderItems)
                {
                    <div class="ui-line">
                        <div class="ui-line__media">
                            <img class="ui-line__image" src="@item.PictureUrl" alt="@item.ProductName" />
                        </div>
                        <div class="ui-line__name">@item.ProductName</div>
                        <div class="ui-line__col" data-label="Unit price">$ @item.UnitPrice.ToString("N2")</div>
                        <div class="ui-line__col" data-label="Quantity">@item.Units</div>
                        <div class="ui-line__col ui-line__col--strong" data-label="Total">$ @Math.Round(item.Units * item.UnitPrice, 2).ToString("N2")</div>
                    </div>
                }
            </div>
        </div>

        <div class="ui-summary">
            <div class="ui-summary__row">
                <span class="ui-summary__row-label">Order total</span>
                <span class="ui-summary__row-value">$ @Model.Total.ToString("N2")</span>
            </div>
            <div class="ui-summary__note">
                <a class="ui-link" asp-controller="Order" asp-action="MyOrders">Back to my orders</a>
            </div>
        </div>
    </div>
</div>
