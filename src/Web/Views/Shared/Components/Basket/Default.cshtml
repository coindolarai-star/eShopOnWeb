@model BasketComponentViewModel

@{
    ViewData["Title"] = "My Basket";
}

<a class="ui-cart" asp-page="/Basket/Index" title="Basket" aria-label="Basket, @Model.ItemsCount items">
    <img class="ui-cart__icon" src="~/images/cart.png" alt="" />
    <span class="ui-cart__badge">@Model.ItemsCount</span>
</a>
