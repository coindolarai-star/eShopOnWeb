@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="ui-auth">
    <div class="ui-auth__card">
        <h1 class="ui-auth__title">Create your account</h1>
        <p class="ui-auth__subtitle">Register to place orders and follow their status.</p>

        <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="ui-field">
                <label class="ui-field__label" asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="ui-field">
                <label class="ui-field__label" asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="ui-field">
                <label class="ui-field__label" asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="ui-actions">
                <button type="submit" class="ui-button ui-button--block">Register</button>
            </div>
        </form>

        <div class="ui-auth__divider"></div>
        <p class="ui-auth__note">
            Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
